# ==================== 环境变量配置模板 ====================
# 使用方式：
#   1. 复制本文件：cp .env.example .env（Windows: copy .env.example .env）
#   2. 修改 .env 中的值为你的实际配置
#   3. .env 已加入 .gitignore，不会被提交到仓库
#
# Spring Boot 启动时通过 --spring.profiles.active=dev 选择对应 profile
# 环境变量会覆盖 application.yml 中的默认值

# ==================== 通用配置 ====================
# SERVER_PORT=3000
# SPRING_PROFILES_ACTIVE=dev

# ==================== 数据库配置 ====================
# DB_URL=jdbc:mysql://localhost:3306/cls_financial_news_database?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_db_password

# ==================== Redis 配置 ====================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# ==================== 邮件配置 ====================
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@example.com
# MAIL_PASSWORD=your_smtp_password

# ==================== JWT 配置 ====================
# ⚠️ JWT_SECRET 无默认值，必须设置！建议使用 64 字符以上的随机字符串
# JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
# JWT_EXPIRATION=604800000
# JWT_ISSUER=cls-financial-news
# JWT_AUDIENCE=cls-financial-news-users
# JWT_COOKIE_SECURE=false

# ==================== AI 服务配置 ====================
# AI_API_KEY=your_ai_api_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo
# AI_MAX_TOKENS=2000
# AI_TEMPERATURE=0.7

# ==================== 阿里云 OSS 配置（媒体上传） ====================
# 新闻图片/视频上传用，不配置时 /api/media/* 返回 503
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# OSS_BUCKET=your_bucket_name
# OSS_CUSTOM_DOMAIN=https://cdn.example.com

# ==================== 日志配置 ====================
# LOG_LEVEL=debug
