<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.news.mapper.VerificationCodeMapper">

    <resultMap id="BaseResultMap" type="com.financial.news.entity.VerificationCode">
        <id column="id" property="id"/>
        <result column="email" property="email"/>
        <result column="code" property="code"/>
        <result column="username" property="username"/>
        <result column="expires_at" property="expiresAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO verification_codes (email, code, username, expires_at, created_at)
        VALUES (#{email}, #{code}, #{username}, #{expiresAt}, #{createdAt})
    </insert>

    <!-- 取最新一条：同一邮箱可能存在多条未过期验证码 -->
    <select id="selectValid" resultMap="BaseResultMap">
        SELECT id, email, code, username, expires_at, created_at
        FROM verification_codes
        WHERE email = #{email} AND code = #{code} AND expires_at &gt; #{now}
        ORDER BY id DESC
        LIMIT 1
    </select>

    <delete id="deleteById">
        DELETE FROM verification_codes WHERE id = #{id}
    </delete>

    <delete id="deleteByEmail">
        DELETE FROM verification_codes WHERE email = #{email}
    </delete>

</mapper>
