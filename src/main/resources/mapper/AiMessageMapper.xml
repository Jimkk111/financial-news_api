<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.news.mapper.AiMessageMapper">

    <resultMap id="BaseResultMap" type="com.financial.news.entity.AiMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_messages (session_id, role, content, created_at)
        VALUES (#{sessionId}, #{role}, #{content}, #{createdAt})
    </insert>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT id, session_id, role, content, created_at
        FROM ai_messages
        WHERE session_id = #{sessionId}
        ORDER BY created_at ASC
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM ai_messages WHERE session_id = #{sessionId}
    </delete>

</mapper>
