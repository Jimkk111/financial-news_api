<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.news.mapper.CrawlAuditMapper">

    <resultMap id="BaseResultMap" type="com.financial.news.entity.CrawlAudit">
        <id column="id" property="id"/>
        <result column="run_id" property="runId"/>
        <result column="source" property="source"/>
        <result column="article_url" property="articleUrl"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="reason" property="reason"/>
        <result column="content_length" property="contentLength"/>
        <result column="publish_time" property="publishTime"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO crawl_audit (run_id, source, article_url, title, status, reason,
                                 content_length, publish_time, duration_ms, created_at)
        VALUES (#{runId}, #{source}, #{articleUrl}, #{title}, #{status}, #{reason},
                #{contentLength}, #{publishTime}, #{durationMs}, #{createdAt})
    </insert>

</mapper>
