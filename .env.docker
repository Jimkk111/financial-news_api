# ==================== Docker 部署环境变量配置 ====================
# 使用方式：
#   1. 复制本文件：cp .env.docker .env
#   2. 修改 .env 中的值为你的实际配置
#   3. .env 已加入 .gitignore，不会被提交到仓库
#   4. 启动：docker compose up -d
#
# ⚠️ 启动前请务必修改所有标记为"必须修改"的配置项

# ==================== 通用配置 ====================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=3000

# ==================== MySQL 配置 ====================
# 必须修改：设置一个强密码
MYSQL_ROOT_PASSWORD=change_me_root_password_2026
MYSQL_DATABASE=cls_financial_news_database
MYSQL_USER=financial
MYSQL_PASSWORD=change_me_db_password_2026

# 应用连接 MySQL 的 URL（容器间通过服务名通信）
DB_URL=jdbc:mysql://mysql:3306/cls_financial_news_database?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=financial
DB_PASSWORD=change_me_db_password_2026

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password_2026
REDIS_DATABASE=0

# ==================== 邮件配置 ====================
# 按实际情况修改
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password

# ==================== JWT 配置 ====================
# 必须修改：生成一个 64 字符以上的随机密钥
# 生成命令：openssl rand -base64 64
JWT_SECRET=change_me_to_random_secret_at_least_64_chars
JWT_EXPIRATION=604800000
JWT_ISSUER=cls-financial-news
JWT_AUDIENCE=cls-financial-news-users
JWT_COOKIE_SECURE=true

# ==================== AI 服务配置 ====================
# 必须修改：填入你的 AI API Key
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# 爬虫 Agent 配置（可选，不填则复用 AI 配置）
# CRAWLER_AI_API_KEY=
# CRAWLER_AI_BASE_URL=
# CRAWLER_AI_MODEL=gpt-4o-mini

# ==================== 阿里云 OSS 配置（媒体上传） ====================
# 新闻图片/视频上传用，必须修改：填入你的 OSS 信息；不配置时 /api/media/* 返回 503
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name
# 可选：CDN/自定义加速域名
# OSS_CUSTOM_DOMAIN=https://cdn.example.com

# ==================== 日志配置 ====================
LOG_LEVEL=info

# ==================== Knife4j (Swagger) ====================
# 生产环境默认关闭
KNIFE4J_ENABLE=false
