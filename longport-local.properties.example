# 复制为 longport-local.properties 后填写，真实文件已被 Git/Docker 忽略。
# IDEA 工作目录须为项目根目录；也可直接配置以下 LONGPORT_* 环境变量。
quote.provider.primary=${QUOTE_PROVIDER:longport}
quote.provider.longport-app-key=${LONGPORT_APP_KEY:}
quote.provider.longport-app-secret=${LONGPORT_APP_SECRET:}
quote.provider.longport-access-token=${LONGPORT_ACCESS_TOKEN:}
quote.provider.longport-region=${LONGPORT_REGION:cn}
quote.sync.security-provider=${QUOTE_SECURITY_PROVIDER:itick}
